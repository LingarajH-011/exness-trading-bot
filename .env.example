# Optional. Normally you enter your Exness details on the Settings page instead.
# Everything here can also be set as a normal environment variable.

# --- Web app ---
# FLASK_HOST=127.0.0.1        # use 0.0.0.0 only if a firewall restricts access
# PORT=5000
# COOKIE_SECURE=1             # set to 1 when served over HTTPS
# TRUST_PROXY=1               # set to 1 when behind nginx / a load balancer
# DASHBOARD_PASSWORD=         # skips the first-run setup page (min 10 characters)
# BOT_DATA_DIR=               # where encrypted data is kept (default: ./data)
# BOT_SECRET_KEY=             # Fernet key; keeps the encryption key off the disk
# FLASK_SECRET_KEY=           # session signing key (auto-generated if empty)

# --- Legacy fallback (used only if nothing is saved from the Settings page) ---
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=Exness-MT5Real
# MT5_PATH=
